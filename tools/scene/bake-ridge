#!/bin/sh
set -eu
cd "$(dirname "$0")/../.."
py="$HOME/.t3/portfolio-redesign-v4/tools/bake-venv/bin/python"
out=.tools/out/o3d/bake
mkdir -p "$out" public/scene/ridge
"$py" tools/scene/lake/inputs.py
for theme in day night; do
    "$py" tools/scene/lake/author.py --theme "$theme" --material-library "$out/$theme.blend" --output "$out/library.png" > "$out/library-$theme.log" 2>&1
done
for gate in wide tall; do
    for theme in day night; do
        set -- --slope .80 --breakage 1.65 --sun-z 2.4 --flux 31 --layers --samples 24 --library "$out/$theme.blend"
        if [ "$theme" = night ]; then set -- "$@" --night --flux 42; fi
        if [ "$gate" = wide ]; then
            set -- "$@" --width 3456 --distance 38.5 --height 3.2 --aim -4.7 --roll -3
        else
            set -- "$@" --width 1080 --distance 36 --height 3.05 --aim -.23 --roll -1 --target-z -.62 --phone
        fi
        "$py" tools/scene/ridge/study.py "$out/$gate-$theme.png" "$@" > "$out/$gate-$theme.log" 2>&1
    done
done
"$py" tools/scene/ridge/layers.py "$out" public/scene/ridge
